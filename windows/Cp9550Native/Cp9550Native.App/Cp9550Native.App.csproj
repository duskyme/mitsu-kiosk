<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <AssemblyName>CP9550Native</AssemblyName>
    <RootNamespace>Cp9550Native.App</RootNamespace>
    <Product>CP-9550 Native</Product>
    <Company>CP9550 Native</Company>
    <Description>Native Windows print app for Mitsubishi CP-9550DW-S</Description>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cp9550Native.Core\Cp9550Native.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\inf\CP9550DW-S.inf" Link="drivers\CP9550DW-S.inf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\install.ps1" Link="drivers\install.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
