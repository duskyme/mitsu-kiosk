; WinUSB device install for Mitsubishi CP-9550DW-S (kiosk)
; USB\VID_06D3&PID_03A5
;
; This is NOT a spooler class printer driver. It binds WinUSB so the
; user-mode print service in windows/print-service can speak the native
; dye-sub protocol at full resolution without Gutenprint color mangling.
;
; Install (Admin PowerShell):
;   pnputil /add-driver CP9550DW-S.inf /install
; Or run ..\install.ps1

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
CatalogFile = CP9550DW-S.cat
DriverVer   = 11/01/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64,NTarm64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_06D3&PID_03A5

[Standard.NTarm64]
%DeviceName% = USB_Install, USB\VID_06D3&PID_03A5

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = DeviceInterface_AddReg

[DeviceInterface_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{d3c9550a-06d3-4a55-9d77-c9550dws0001}"

[Strings]
ManufacturerName = "CP9550 Native (community)"
DeviceName       = "Mitsubishi CP-9550DW-S (WinUSB)"
