*%
*% CP-9550DW-S printer GPD — Phase 2 media + quality.
*% Shape follows Microsoft MSxpsXPS.gpd (required cursor cmds).
*% Native pixels come from Cp9550RenderFilter (not GPD DPI):
*%   4x6 → 2152×1416, 5x7 → 1812×2452, 6x9 → 2152×2792.
*%

*GPDSpecVersion: "1.0"
*GPDFileVersion: "1.0"

*Include:        "StdNames.gpd"
*Include:        "MsXpsInc.gpd"
*ResourceDLL:    "unires.dll"

*GPDFileName:    "CP9550.gpd"
*ModelName:      "Mitsubishi CP-9550DW-S (V4)"
*MasterUnits:    PAIR(1200, 1200)
*PrinterType:    PAGE
*MaxCopies:      680

*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: LANDSCAPE_CC270

    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }

    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}

*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: DPI300

    *Option: DPI300
    {
        *Name: "300x300 " =DOTS_PER_INCH
        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *SpotDiameter: 100
    }
}

*% Master units = 1200 / inch. LETTER kept as Notepad / queue bring-up fallback.
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: PHOTO_4x6

    *Option: PHOTO_4x6
    {
        *Name: "4 x 6 in"
        *PrintSchemaKeywordMap: "NorthAmerica4x6"
        *PageDimensions: PAIR(4800, 7200)
        *PrintableOrigin: PAIR(0, 0)
        *PrintableArea: PAIR(4800, 7200)
    }

    *Option: PHOTO_5x7
    {
        *Name: "5 x 7 in"
        *PrintSchemaKeywordMap: "NorthAmerica5x7"
        *PageDimensions: PAIR(6000, 8400)
        *PrintableOrigin: PAIR(0, 0)
        *PrintableArea: PAIR(6000, 8400)
    }

    *Option: PHOTO_6x9
    {
        *Name: "6 x 9 in"
        *PrintSchemaKeywordMap: "NorthAmerica6x9"
        *PageDimensions: PAIR(7200, 10800)
        *PrintableOrigin: PAIR(0, 0)
        *PrintableArea: PAIR(7200, 10800)
    }

    *Option: LETTER
    {
        *rcNameID: =RCID_DMPAPER_SYSTEM_NAME
        *PrintableOrigin: PAIR(600, 600)
        *PrintableArea: PAIR(9000, 12000)
    }
}

*% Maps to psk:PageOutputQuality. Filter scrapes Normal/High/Photographic (+ aliases).
*Feature: Quality
{
    *Name: "Print Quality"
    *DefaultOption: SUPERFINE

    *Option: FINE
    {
        *Name: "Fine"
        *PrintSchemaKeywordMap: "Normal"
    }

    *Option: SUPERFINE
    {
        *Name: "SuperFine"
        *PrintSchemaKeywordMap: "High"
    }

    *Option: FINEDEEP
    {
        *Name: "FineDeep"
        *PrintSchemaKeywordMap: "Photographic"
    }
}

*Feature: MediaType
{
    *rcNameID: =MEDIA_TYPE_DISPLAY
    *DefaultOption: STANDARD

    *Option: STANDARD
    {
        *rcNameID: =PLAIN_PAPER_DISPLAY
    }
}

*% Mandatory cursor commands (missing these → Add-Printer ERROR_CAN_NOT_COMPLETE 0x800703eb)
*Command: CmdCR { *Cmd : "" }
*Command: CmdLF { *Cmd : "" }
*Command: CmdFF { *Cmd : "" }
*Command: CmdSendBlockData { *Cmd : "" }
