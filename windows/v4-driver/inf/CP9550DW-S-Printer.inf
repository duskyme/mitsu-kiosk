; Printer package for Mitsubishi CP-9550DW-S (Phase 1)
;
; This is NOT the WinUSB device INF (see windows\inf\CP9550DW-S.inf).
; Queue uses Standard TCP/IP Port â†’ 127.0.0.1:9100 (RAW) where
; Cp9550SpoolBridge listens and calls PrinterDevice.SendSpool.
;
; Lab notes:
; - ClassVer=4.0 + DestDir 13 + PackageAware works for queue + ICC soft-proof.
; - GPD MUST include CmdCR/CmdLF/CmdFF/CmdSendBlockData or Add-Printer returns 0x800703eb.
; - Pipeline file name must be <DataFileStem>-pipelineconfig.xml â†’ CP9550-pipelineconfig.xml.
; - IHV filter DLL ships in DriverFiles (CopyFiles). Never put it in manifest RequiredFiles
;   (core-package resolution only -> PrintService event 235).
; - Pipeline XML comments must not contain "--" (invalid XML -> event 372 / 0x80004005
;   before Cp9550RenderFilter::InitializeFilter).
; - Prefer XpsFormat=XPS,OpenXPS; filter uses CreatePageFromStream1 (OpenXPS-safe).
;   OpenXPS-only + classic CreatePageFromStream -> XPS_E_INVALID_MARKUP 0x8052000C.

[Version]
Signature   = "$Windows NT$"
Provider    = %ManufacturerName%
Class       = Printer
ClassGUID   = {4D36E979-E325-11CE-BFC1-08002BE10318}
CatalogFile = CP9550DW-S-Printer.cat
ClassVer    = 4.0
DriverVer   = 11/01/2026,0.3.11.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
"Mitsubishi CP-9550DW-S (V4)" = Install, {A55C9550-06D3-4A55-9D77-C9550D0500A1}

[Install]
CopyFiles = DriverFiles, ColorFiles

[Install.Services]
AddService = , %SPSVCINST_ASSOCSERVICE%

[DriverFiles]
CP9550.gpd
CP9550-manifest.ini
CP9550-pipelineconfig.xml
Cp9550RenderFilter.dll

[ColorFiles]
CP955_01.ICC

[DestinationDirs]
DefaultDestDir = 13
ColorFiles     = 66003

; Prefer install-printer.ps1 which stages a flat package next to the INF.
[SourceDisksNames.amd64]
1 = %Location%,,,
2 = %Location%,,,color
3 = %Location%,,,gpd
4 = %Location%,,,pipeline
5 = %Location%,,,filter\_out\Release

[SourceDisksFiles]
CP9550.gpd = 3
CP9550-manifest.ini = 1
CP9550-pipelineconfig.xml = 4
Cp9550RenderFilter.dll = 5
CP955_01.ICC = 2

[PrinterPackageInstallation.amd64]
PackageAware = TRUE

[Strings]
ManufacturerName = "CP9550 Native (community)"
Location         = "CP-9550 V4 Phase 1 package"
SPSVCINST_ASSOCSERVICE = 0x00000002

