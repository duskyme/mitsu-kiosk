<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 1 IHV render filter pipeline.
  XPS to Cp9550RenderFilter (planar RGB spool) to Standard TCP/IP Port to Cp9550SpoolBridge.
  XpsRasterService is a FilterServiceProvider (property bag), not a RequiredFiles entry.
  Cp9550RenderFilter.dll ships via INF CopyFiles only. Never put it in manifest
  RequiredFiles (core-package resolution only triggers PrintService event 235).
  XML comments must not contain double-hyphen; that made the pipeline unparsable
  and surfaced as PrintService event 372 / 0x80004005 before InitializeFilter.
-->
<Filters>
  <Filter dll="Cp9550RenderFilter.dll"
          clsid="{C9550F17-06D3-4A55-9D77-C9550D0500F1}"
          name="CP-9550 Render Filter">
    <Input guid="{b8cf8530-5562-47c4-ab67-b1f69ecf961e}" comment="IID_IXpsDocumentProvider"/>
    <Output guid="{65bb7f1b-371e-4571-8ac7-912f510c1a38}" comment="IID_IPrintWriteStream"/>
  </Filter>
  <FilterServiceProvider dll="XpsRasterService.dll"/>
</Filters>
